{"projects": [{"id": "project-1", "title": "品牌IP设计", "description": "为OBSBOT打造品牌IP，探索角色设定、视觉延展与衍生物料。", "image": "/assets/covers/project-1.jpg", "gallery": ["/assets/project-1/2.jpg", "/assets/project-1/3.png", "/assets/saved/e836120b9f8c3657d69cbaba92dd83345825f52f49640b8582320e38863112ca.jpeg", "/assets/saved/cf28a17f0f043431738c02bfe9c7b7a864d7baf113b712a19af4a51352b5f7df.jpeg", "/assets/project-1/6.png", "/assets/project-1/7.png", "/assets/project-1/8.png", "/assets/project-1/9.png"], "coverCrop": {"x": 13, "y": 50, "zoom": 1}, "detailImage": "/assets/project-1/1.png", "seamless": true, "contentImportVersion": "ip-2026-11-09-v1", "descriptionVersion": "intro-20261113-v1"}, {"id": "project-2", "title": "AI模特+电商TVC视频", "description": "以自然情绪为线索，探索AI模特、服装造型与品牌影像表达。", "image": "/assets/covers/project-2.jpg", "gallery": ["/assets/project-2/2.jpg", "/assets/project-2/3.jpg", "/assets/project-2/4.jpg", "/assets/project-2/5.jpg", "/assets/project-2/6.jpg", "/assets/project-2/7.jpg", "/assets/project-2/8.jpg", "/assets/saved/2e67c2dcc813f6899eada50b83911ec54e487f0d98897d8d60272cc6740d3776.jpeg", "/assets/project-2/11.jpg", "/assets/project-2/12.jpg", "/assets/project-2/13.jpg", "/assets/saved/38defe8b327c522e850f249fc0280f672fa2d0229f826307095b4d23c8dfa8be.jpeg", "/assets/project-2/15.png", "/assets/project-2/16.jpg", "/assets/saved/7a3f0397438df65e77cba9787eefc57f9c7831293d57ed8f9967c98c06f2b361.jpeg", "/assets/project-2/18.jpg", "/assets/saved/e60e1f3e604549f6b04783dd71986617fe38a11675fe4057f77189c36ae118d5.jpeg", "/assets/project-2/20.jpg", "/assets/saved/ad566a27040dbb46beccfc5427a7708052b187b3f7dac486a2ec10e0bc9ba573.jpg", "/assets/project-2/23.jpg", "/assets/project-2/24.jpg", "/assets/project-2/25.jpg", "/assets/project-2/26.jpg", "/assets/project-2/27.jpg", "/assets/project-2/28.jpg"], "coverCrop": {"x": 50, "y": 50, "zoom": 1}, "detailImage": "/assets/project-2/1.jpg", "seamless": true, "contentImportVersion": "model-2026-11-09-v1", "descriptionVersion": "intro-20261113-v1", "tvcPrompt": "整体提示词\n低饱和灰绿与米白色调，电影感柔光，保持人物身份、服装与材质一致。以眼神、披衣动作和面料触感串联无性别穿着叙事，镜头克制、过渡自然。以下时间按成片约14.4秒划分。\n\n00:00–00:02｜苏醒前的静默\n面部极近景，模特闭眼，侧光轻扫眉骨、鼻梁与肌肤纹理，背景沉入暗部。镜头保持稳定，呈现细微呼吸与安静情绪。\n\n00:02–00:03.2｜睁眼与感知\n延续同一近景，模特缓缓睁眼，视线自然向前。突出瞳孔反光与真实肤质，保持浅景深和柔和明暗过渡，不改变人物五官。\n\n00:03.2–00:05.4｜披衣与舒展\n切换背面中景，模特扬起灰色外套、伸展双臂并完成披衣。浅灰背景简洁留白，衣摆随动作自然展开，强调面料的重量、褶皱与垂坠。\n\n00:05.4–00:08｜走入衣阵\n背面跟随镜头，模特穿过悬挂的灰白衣物。利用两侧衣物形成纵深与前景遮挡，保持步伐平缓，让衣料在人物经过时轻微摆动。\n\n00:08–00:10.5｜触碰与感受\n转入侧面中近景，模特抬手轻触身旁的浅色衣物。柔和日光穿过衣阵，照亮手指与布料边缘，突出触摸动作、细腻织物与自然神态。\n\n00:10.5–00:12.8｜情绪落点\n镜头逐渐靠近侧脸，模特微微垂眼，动作放缓。保留皮肤、发丝和领口细节，以柔光和浅景深收束情绪，表达舒适、自洽的穿着状态。\n\n00:12.8–00:14.4｜品牌收束\n人物与衣阵画面上浮现OE及ORGANIC EMOTION白色标识，保持中心视觉清晰，随后过渡至黑色品牌尾帧，以简洁留白结束。", "tvcPromptVersion": "timed-v1"}, {"id": "project-3", "title": "亚马逊实战 · 透气护腰带", "description": "亚马逊实习实战：护腰带卖点图、UGC广告与首图透气质感优化。", "image": "/assets/covers/project-3.jpg", "gallery": ["/assets/project-3/selling-1.jpg", "/assets/project-3/selling-2.jpg", "/assets/project-3/selling-3.jpg", "/assets/project-3/selling-4.jpg", "/assets/project-3/selling-5.jpg", "/assets/project-3/selling-6.png", "/assets/project-3/selling-7.jpg", "/assets/project-3/selling-8.png", "/assets/project-3/selling-9.png", "/assets/project-3/selling-10.jpg"], "detailImage": "/assets/saved/deb4da0ae95dc5b5e8d5abbe0d3615bd706049216f4cf7b4c3c1fecdf26b0a7a.jpeg", "coverCrop": {"x": 42, "y": 100, "zoom": 1}, "videoSource": "/assets/project-3/ad-full.mp4", "alternateVideo": "/assets/project-3/ad-full.mp4", "comparisonImage": "/assets/project-3/comparison-clean.png", "caseCopy": {"overview": "亚马逊上线实景。", "overviewNote": "亚马逊实习实战 · 轻薄透气护腰带", "video": "让产品走进日常。", "videoNote": "使用 Seedance2.5 制作 UGC 风格广告，以日常使用场景介绍护腰带的产品特点。", "short": "广告删减版", "full": "广告完整版", "cycleLabel": "制作周期", "cycle": "4 天", "ctrLabel": "上线后点击率", "ctr": "超过 1.5%", "conversionLabel": "转化率", "conversion": "超过 10%", "selling": "完整电商图组。", "sellingNote": "围绕产品特点、使用场景与穿戴体验，构建完整的产品视觉介绍。", "comparison": "让透气性，看得见。", "comparisonNote": "重点优化腰带网眼的通透感，还原更真实的透气效果，让轻薄、透气的产品特点在首图中更清晰可见。优化后，点击率从 0.5% 提升至 0.7%，提高 0.2 个百分点。"}, "contentImportVersion": "amazon-study-v3", "descriptionVersion": "intro-20261113-v1"}, {"id": "project-4", "title": "爆款视频复刻", "description": "拆解子弹时间镜头，以AI重构人物、产品与动作，完成广告短片。", "image": "/assets/covers/project-4.jpg", "gallery": [], "detailImage": "/assets/saved/45d42c0420c331b4b70bb3b82d6acfcf41c4bef7fa6117faaf1b08a32c1fb40b.jpeg", "coverCrop": {"x": 50, "y": 36, "zoom": 1}, "videoSource": "/assets/project-4/film-study.mp4", "contentImportVersion": "film-study-2026-11-10-v2", "descriptionVersion": "intro-20261113-v1"}, {"id": "project-5", "title": "3C电子类电商图组", "description": "围绕OBSBOT Me智能跟拍，构建产品叙事与完整电商视觉。", "image": "/assets/covers/project-5.jpg", "gallery": [], "coverCrop": {"x": 53, "y": 44, "zoom": 1}, "embeddedPage": "/portfolios/project-5.html", "contentImportVersion": "obsbot-html-2026-11-10-v1", "coverImportVersion": "obsbot-expanded-2026-11-10-v2", "descriptionVersion": "intro-20261113-v1"}, {"id": "project-6", "title": "摄影作品", "description": "汇集人像、风景摄影与建筑设计，以互动照片球体呈现多元视角。", "image": "/assets/covers/project-6.jpg", "gallery": [], "coverCrop": {"x": 50, "y": 50, "zoom": 1}, "sphereImages": ["/assets/saved/d805322ca81c15e4db2da557821078a83fe8c379fabe4a044fe75ab174f240e8.jpeg", "/assets/saved/d5aed68abe49b7f084a6c155d50019850664c9df15fc278383684d656c7d09b6.jpeg", "/assets/saved/7a554fce55f7259a8dd5cabf0822322b9315cc63c9da904f5a579b5dad41d0ce.jpeg", "/assets/saved/69f7ffd9ef0c2ee517ac8f6e252d3a50d21b7af52577f5452a5d7dd891cfeda3.jpeg", "/assets/saved/1b1bfa9acd3725fcb3d228f6501c017be6b5defd368a569cd98e3e3230288e5a.jpg", "/assets/project-6/added-20261111-01.jpg", "/assets/project-6/added-20261111-02.jpg", "/assets/project-6/added-20261111-03.jpg", "/assets/project-6/added-20261111-04.jpg", "/assets/project-6/added-20261111-05.jpg", "/assets/project-6/added-20261111-06.jpg", "/assets/project-6/added-20261111-07.jpg", "/assets/project-6/added-20261111-08.jpg", "/assets/project-6/added-20261111-09.jpg", "/assets/p